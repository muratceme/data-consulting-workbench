        ],
        "measures": [
          {
            "name": "Toplam Tutar",
            "expression": "SUM(Satislar[Tutar])",
            "formatString": "#,0.00",
            "description": "KDV hariç satış tutarı."
          },
          {
            "name": "Ortalama Fiyat",
            "expression": "[Toplam Tutar] / SUM(Satislar[Miktar])",
            "description": "Birim başına ortalama fiyat."
          },
          {
            "name": "Kar",
            "expression": "Satislar[Toplam Tutar] - SUM([Maliyet])",
            "formatString": "#,0",
            "description": "Brüt kâr."
          },
          {
            "name": "Kar Marji",
            "expression": "IFERROR(DIVIDE([Kar], [Toplam Tutar]), 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Siparis Sayisi",
            "expression": "DISTINCTCOUNT(Satislar[SatisID])",
            "formatString": "#,0",
            "description": "Tekil sipariş sayısı."
          }
        ],
