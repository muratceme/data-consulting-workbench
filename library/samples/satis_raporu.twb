<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='26.1' source-build='0.0.0 (0000.0.0.0)' source-platform='win' version='26.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <ManifestByVersion />
  </document-format-change-manifest>
  <datasources>
    <datasource caption="SatisDetay" inline="true" name="federated.rapor" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="satis_detay.csv" name="textscan.rapor">
            <connection class="textscan" directory="C:/Veri" filename="satis_detay.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.rapor" name="satis_detay.csv" table="[satis_detay#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="tr_TR" separator=";">
            <column datatype="string" name="siparis_no" ordinal="0" />
            <column datatype="date" name="siparis_tarihi" ordinal="1" />
            <column datatype="string" name="bolge" ordinal="2" />
            <column datatype="string" name="kanal" ordinal="3" />
            <column datatype="string" name="kategori" ordinal="4" />
            <column datatype="string" name="urun" ordinal="5" />
            <column datatype="string" name="musteri_eposta" ordinal="6" />
            <column datatype="integer" name="adet" ordinal="7" />
            <column datatype="real" name="birim_fiyat" ordinal="8" />
            <column datatype="real" name="tutar" ordinal="9" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Siparis No" datatype="string" name="[siparis_no]" role="dimension" type="nominal" />
      <column caption="Siparis Tarihi" datatype="date" name="[siparis_tarihi]" role="dimension" type="ordinal" />
      <column caption="Bolge" datatype="string" name="[bolge]" role="dimension" type="nominal" />
      <column caption="Kanal" datatype="string" name="[kanal]" role="dimension" type="nominal" />
      <column caption="Kategori" datatype="string" name="[kategori]" role="dimension" type="nominal" />
      <column caption="Urun" datatype="string" name="[urun]" role="dimension" type="nominal" />
      <column caption="Musteri Eposta" datatype="string" name="[musteri_eposta]" role="dimension" type="nominal" />
      <column caption="Adet" datatype="integer" name="[adet]" role="measure" type="quantitative" />
      <column caption="Birim Fiyat" datatype="real" name="[birim_fiyat]" role="measure" type="quantitative" />
      <column caption="Tutar" datatype="real" name="[tutar]" role="measure" type="quantitative" />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="KPI Toplam Tutar">
      <table>
        <view>
          <datasources>
            <datasource caption="SatisDetay" name="federated.rapor" />
          </datasources>
          <datasource-dependencies datasource="federated.rapor">
            <column caption="Tutar" datatype="real" name="[tutar]" role="measure" type="quantitative" />
            <column-instance column="[tutar]" derivation="Sum" name="[sum:tutar:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
              <encodings>
                <text column="[federated.rapor].[sum:tutar:qk]" />
              </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
      <simple-id uuid="{BCECF82B-2E4F-5F94-9C6D-EC6054537EBA}" />
    </worksheet>
